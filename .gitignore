# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# custom
*.bk.*

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare
/.open-next/
/.wrangler/
# Not covered by the .env* rule above — it needs its own line.
.dev.vars
.dev.vars.*
# ~500KB of generated workerd types, pinned to one workerd build. Regenerate
# with `pnpm cf-typegen` rather than committing it.
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts
